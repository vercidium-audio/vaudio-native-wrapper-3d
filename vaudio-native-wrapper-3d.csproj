<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Platforms>AnyCPU</Platforms>
        <Configurations>Debug;Release;Production</Configurations>

        <Version>1.7.0</Version>
        <AssemblyVersion>1.7.0</AssemblyVersion>
        <FileVersion>1.7.0</FileVersion>
        <InformationalVersion>1.7.0</InformationalVersion>
    </PropertyGroup>

    <!-- common is a shared source folder, not a referenced assembly, used by both this project and vaudio-native-wrapper-2d -->
    <ItemGroup>
        <Compile Include="..\vaudio-native-wrapper-common\**\*.cs" Exclude="..\vaudio-native-wrapper-common\obj\**;..\vaudio-native-wrapper-common\bin\**" LinkBase="common" />
    </ItemGroup>
</Project>
